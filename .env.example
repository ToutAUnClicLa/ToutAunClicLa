# =============================================================================
# FRONTEND - ToutAunClicLa (Next.js)  ·  Variables de entorno
# =============================================================================
# Copia este archivo:  cp .env.example .env.local
# Las variables NEXT_PUBLIC_* se exponen al navegador (NO pongas secretos ahí).
#
# Nota: BASE_URL de la API se autodetecta por NODE_ENV en varios servicios:
#   dev  -> http://localhost:5500/api/v1
#   prod -> https://backendtoutaunclicla-production.up.railway.app/api/v1
# NEXT_PUBLIC_API_BASE_URL se usa directamente en checkout/auth/etc., así que
# debe estar definida en ambos entornos.
# =============================================================================

# --- Supabase (OBLIGATORIO) ------------------------------------------------
# Sin estas el cliente lanza "Missing Supabase environment variables".
# Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJI...   # public anon key

# --- API del backend (OBLIGATORIO) -----------------------------------------
# URL base del backend Express, incluyendo /api/v1.
# Dev:  http://localhost:5500/api/v1
# Prod: https://backendtoutaunclicla-production.up.railway.app/api/v1
NEXT_PUBLIC_API_BASE_URL=http://localhost:5500/api/v1

# --- URLs del sitio --------------------------------------------------------
# Origen público para Pro card/QR/register (no lib/constants). Default: http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# URL base para sitemap y URLs de éxito/cancelación de checkout.
# Dev: http://localhost:3000  ·  Prod: https://www.toutaunclicla.com
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# --- Autenticación ---------------------------------------------------------
# Needed for middleware on /profile/orders and /profile/notifications.
# Must match the backend JWT_SECRET. If unset, those routes look logged-out.
JWT_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria
