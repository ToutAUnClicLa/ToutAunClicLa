# Copy to .env.local. NEXT_PUBLIC_* is inlined for the browser — no secrets there.
# Same names on Vercel Production and Preview. Do not set NODE_ENV (Next injects).
# No Stripe publishable key: checkout is backend-hosted.

# Throw at module load if missing.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJI...

# Must include /api/v1. Local: localhost:5500. Production/Preview: Railway public URL.
NEXT_PUBLIC_API_BASE_URL=http://localhost:5500/api/v1

# Sitemap + Stripe success/cancel. Production: live origin. Preview: preview origin (else www).
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Pro card/QR/register. Production: live origin. Preview: preview origin (else localhost).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Must match backend JWT_SECRET. Unset → /profile/orders and /profile/notifications look logged-out.
JWT_SECRET=replace-with-a-long-random-string
